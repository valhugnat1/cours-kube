---
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import Paysage from '../components/Paysage.astro';
import { paysageDePartie } from '../data/paysages';
import { parcours, toutesLesLecons, urlLecon, estDuParcours } from '../data/lecons';

const parties = await parcours();
// Ordre du parcours (leçons et récaps) pour la carte « Reprendre » ; le compteur ne compte que les leçons.
const ordre = (await toutesLesLecons())
  .filter(estDuParcours)
  .map((l) => ({ id: l.id, titre: l.data.titre, url: urlLecon(l), etape: l.data.etape, recap: l.data.type === 'recap' }));
const premiere = ordre[0];
const nbLecons = ordre.filter((l) => !l.recap).length;

---
<Base titre="Parcours">
  <section class="accueil" data-ordre={JSON.stringify(ordre)}>
    <div class="paysage hero" data-largeur="96" style="--hauteur:13.5rem" data-hero>
      <div class="hero-carte">
        <p class="etiquette-pixel">Ton parcours</p>
        <p class="hero-chiffre"><span data-nb-lues>0</span><small> / {nbLecons}</small></p>
        <p class="hero-legende">leçons lues</p>
        <div class="cases hero-cases" aria-hidden="true" data-cases>{Array.from({ length: 20 }, () => <i />)}</div>
      </div>
      <p class="hero-invite etiquette-pixel" data-hero-invite></p>
    </div>

    {premiere ? (
      <a class="carte-reprendre px" href={premiere.url} data-reprendre>
        <span class="etiquette-pixel" data-reprendre-libelle>Commencer</span>
        <span class="carte-titre" data-reprendre-titre>{premiere.titre}</span>
        <span class="discret" data-reprendre-etape>Étape {premiere.etape}</span>
        <span class="bouton carte-bouton">▶ Faire une leçon de 5 min</span>
      </a>
    ) : (
      <p>Aucune leçon générée pour l’instant. Lance <code>/lecon etape-00</code> dans Claude Code.</p>
    )}
    <a class="carte-revoir px" href="/revoir/" data-carte-revoir hidden>
      <span class="etiquette-pixel">À revoir</span>
      <span><span data-nb-revoir-texte></span> à reprendre</span>
    </a>
  </section>

  {parties.map((p) => (
    <section class="partie">
      <Paysage scene={paysageDePartie[p.id]} hauteur="6.5rem" class="partie-paysage" titre={`Partie ${p.id}`} sousTitre={p.titre} />
      <p class="discret partie-resume">{p.resume}</p>
      {p.etapes.map((e) => (
        <div class:list={['etape', { vide: e.lecons.length === 0 }]} id={`etape-${e.n}`}>
          <h3>
            <span>Étape {e.n}. {e.titre}</span>
            {e.lecons.length > 0 && (
              <span class="compte" data-compte={JSON.stringify(e.lecons.filter((l) => l.data.type === 'lecon').map((l) => l.id))}></span>
            )}
          </h3>
          {e.lecons.length > 0
            ? <Rail stations={e.lecons.map((l) => ({ id: l.id, titre: l.data.titre, url: urlLecon(l), type: l.data.type }))} />
            : <p class="discret">Pas encore générée.</p>}
        </div>
      ))}
      {p.etapes.some((e) => e.lecons.length > 0) && (
        <a class="bouton secondaire controle" href={`/controle/${p.id.toLowerCase()}/`}>
          Contrôle de la partie {p.id} <span class="score-controle" data-score-controle={p.id}></span>
        </a>
      )}
    </section>
  ))}
</Base>

<style>
  .accueil { margin: -1rem -1rem 1.5rem; }
  .hero { border-bottom: 2px solid var(--contour); }
  .hero-carte {
    position: absolute; left: 1rem; top: 1rem; z-index: 1; min-width: 11rem; pointer-events: none;
    background: rgb(255 249 236 / 0.86); color: #2f3550; padding: 0.55rem 0.8rem 0.7rem;
    clip-path: polygon(5px 0, calc(100% - 5px) 0, 100% 5px, 100% calc(100% - 5px), calc(100% - 5px) 100%, 5px 100%, 0 calc(100% - 5px), 0 5px);
  }
  .hero.sombre .hero-carte { background: rgb(47 53 80 / 0.66); color: #fff9ec; }
  .hero-carte p { margin: 0; }
  .hero-chiffre { font-family: var(--police-pixel); font-size: 3.3rem; line-height: 0.95; margin-top: 0.2rem !important; }
  .hero-chiffre small { font-size: 1.6rem; opacity: 0.7; }
  .hero-legende { font-size: 0.85rem; }
  .hero-cases { margin-top: 0.45rem; height: 9px; }
  .hero-cases :global(i) { background: rgb(47 53 80 / 0.15); }
  .hero.sombre .hero-cases :global(i) { background: rgb(255 249 236 / 0.2); }
  .hero-cases :global(i.pleine) { background: #4f8a3c; }
  .hero-invite { position: absolute; right: 0.6rem; bottom: 0.45rem; margin: 0; z-index: 1; font-size: 0.5rem; color: #2f3550; background: rgb(255 249 236 / 0.7); padding: 0.15rem 0.35rem; pointer-events: none; }
  .hero.sombre .hero-invite { color: #fff9ec; background: rgb(47 53 80 / 0.55); }

  .carte-reprendre { display: grid; gap: 0.2rem; margin: 1.4rem 1rem 0; text-decoration: none; color: var(--encre); padding: 0.9rem 1rem 1.1rem; }
  .carte-reprendre .etiquette-pixel { color: var(--encre-douce); }
  .carte-titre { font-size: 1.25rem; font-weight: 650; line-height: 1.3; }
  .carte-bouton { margin-top: 0.7rem; }
  .carte-reprendre:active .carte-bouton { transform: translate(3px, 3px); filter: none; }
  .carte-revoir { --fond: var(--ambre-clair); --decale: 3px; display: grid; gap: 0.1rem; margin: 1rem 1rem 0; text-decoration: none; color: var(--encre); padding: 0.65rem 1rem 0.75rem; font-weight: 650; }

  .partie { margin-top: 2.75rem; }
  .partie :global(.partie-paysage) { border: 2px solid var(--contour); box-shadow: 4px 4px 0 var(--ombre); }
  .partie-resume { margin: 0.75rem 0 0; }
  .etape { margin-top: 1.25rem; }
  .etape h3 { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin: 0 0 0.2rem; font-size: 1.4rem; }
  .etape.vide h3 { color: var(--encre-douce); }
  .etape.vide p { margin: 0; }
  .compte { color: var(--encre-douce); font-size: 1.2rem; white-space: nowrap; }
  .controle { margin-top: 1.4rem; font-size: 1.3rem; }
  .score-controle { color: var(--encre-douce); }
  @media (min-width: 40rem) {
    .accueil { margin: 0 0 1.5rem; }
    .hero { border: 2px solid var(--contour); box-shadow: 4px 4px 0 var(--ombre); }
    .carte-reprendre, .carte-revoir { margin-left: 0; margin-right: 0; }
  }
</style>
<script>
  import { lire, aRevoir, estLue } from '../scripts/progression';
  import { monterPaysages, sceneDuMoment, SCENES } from '../scripts/paysages';
  const racine = document.querySelector<HTMLElement>('[data-ordre]')!;
  const ordre: { id: string; titre: string; url: string; etape: number; recap: boolean }[] = JSON.parse(racine.dataset.ordre!);
  const lecons = ordre.filter((l) => !l.recap);

  const maj = () => {
    const e = lire();
    const lues = lecons.filter((l) => estLue(e, l.id)).length;
    document.querySelector('[data-nb-lues]')!.textContent = String(lues);
    const cases = document.querySelectorAll('[data-cases] i');
    const pleines = lues === 0 ? 0 : Math.max(1, Math.round((cases.length * lues) / Math.max(1, lecons.length)));
    cases.forEach((c, k) => c.classList.toggle('pleine', k < pleines));

    const suivante = ordre.find((l) => !estLue(e, l.id));
    const carte = document.querySelector<HTMLAnchorElement>('[data-reprendre]');
    if (carte) {
      if (suivante) {
        carte.href = suivante.url;
        carte.querySelector('[data-reprendre-libelle]')!.textContent = lues ? 'Reprendre' : 'Commencer';
        carte.querySelector('[data-reprendre-titre]')!.textContent = suivante.titre;
        carte.querySelector('[data-reprendre-etape]')!.textContent = `Étape ${suivante.etape}${suivante.recap ? ', récap' : ''}`;
      } else if (ordre.length) {
        carte.querySelector('[data-reprendre-libelle]')!.textContent = 'Tout est lu';
        carte.querySelector('[data-reprendre-titre]')!.textContent = 'Fais un contrôle de partie ou vide ta pile « À revoir ».';
        carte.href = '/revoir/';
      }
    }

    const nb = aRevoir(e).length;
    const cr = document.querySelector<HTMLElement>('[data-carte-revoir]')!;
    cr.hidden = nb === 0;
    cr.querySelector('[data-nb-revoir-texte]')!.textContent = nb === 1 ? '1 question' : `${nb} questions`;

    document.querySelectorAll<HTMLElement>('[data-compte]').forEach((el) => {
      const ids: string[] = JSON.parse(el.dataset.compte!);
      el.textContent = `${ids.filter((i) => estLue(e, i)).length}/${ids.length}`;
    });
    document.querySelectorAll<HTMLElement>('[data-score-controle]').forEach((el) => {
      const c = e.controles[el.dataset.scoreControle!];
      el.textContent = c ? `· ${c.score}/${c.total}` : '';
    });
  };
  document.addEventListener('progression', maj);
  maj();

  // Le paysage d'accueil suit le soleil (comme dans l'appli) : grand large le jour, aube, puis nuit.
  const scene = sceneDuMoment();
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  hero.dataset.paysage = scene;
  hero.classList.toggle('sombre', SCENES[scene].sombre);
  hero.querySelector('[data-hero-invite]')!.textContent = SCENES[scene].invite;
  monterPaysages();
</script>
