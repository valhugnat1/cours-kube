---
// Monte un quiz côté client. Les questions sont passées en JSON.
// maitrise : les questions ratées reviennent jusqu'au sans-faute (fin de leçon).
interface Props { questions: unknown[]; id: string; afficherSource?: boolean; melanger?: boolean; maitrise?: boolean; controle?: string; max?: number; revoir?: boolean; paysage?: string }
const { questions, id, afficherSource = false, melanger = false, maitrise = false, controle, max = 0, revoir = false, paysage } = Astro.props;
---
<div class="quiz px" id={id} data-questions={JSON.stringify(questions)} data-source={afficherSource ? '1' : ''}
  data-melanger={melanger ? '1' : ''} data-maitrise={maitrise ? '1' : ''} data-controle={controle ?? ''}
  data-max={max} data-revoir={revoir ? '1' : ''} data-scene-fete={paysage}><slot /></div>
<style>
  .quiz { padding: 1rem 1rem 1.15rem; scroll-margin-top: 4.5rem; }

  /* Rail du quiz : une case par question. */
  .quiz :global(.quiz-rail) { list-style: none; margin: 0.15rem 0 0.6rem; padding: 0; display: flex; gap: 3px; }
  .quiz :global(.quiz-rail li) { flex: 1 1 0; height: 10px; margin: 0; background: var(--trait); transition: background-color 200ms steps(2); }
  .quiz :global(.quiz-rail li.juste) { background: var(--pin-fort); }
  .quiz :global(.quiz-rail li.ratee) { background: var(--rouge-fort); }
  .quiz :global(.quiz-rail li.a-reprendre) { background: var(--ambre-fort); }
  .quiz :global(.quiz-rail li.courante) { outline: 2px solid var(--contour); outline-offset: 1px; }

  .quiz :global(.quiz-compteur) { font-family: var(--police-etiquette); font-size: 0.62rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--encre-douce); margin: 0 0 0.45rem; }
  .quiz :global(.quiz-question) { font-weight: 650; font-size: 1.1rem; line-height: 1.45; margin: 0 0 0.9rem; }
  .quiz :global(.quiz-source) { color: var(--encre-douce); font-size: 0.9rem; margin: -0.5rem 0 0.9rem; }

  .quiz :global(.quiz-choix) { display: grid; gap: 0.6rem; margin: 0 0 1rem; }
  .quiz :global(.quiz-option) {
    display: flex; align-items: flex-start; gap: 0.7rem; width: 100%;
    font: inherit; text-align: left; color: var(--encre); background: var(--papier);
    border: 2px solid var(--contour); border-radius: 0; padding: 0.65rem 0.75rem; cursor: pointer;
    box-shadow: 3px 3px 0 var(--ombre);
    transition: background-color 120ms, transform 60ms steps(1);
    -webkit-tap-highlight-color: transparent;
  }
  .quiz :global(.quiz-lettre) {
    flex: none; display: grid; place-items: center; width: 1.7rem; height: 1.7rem;
    border: 2px solid var(--contour); background: var(--surface); color: var(--encre);
    font-family: var(--police-pixel); font-size: 1.25rem; line-height: 1;
  }
  .quiz :global(.quiz-texte) { min-width: 0; overflow-wrap: anywhere; padding-top: 0.05rem; }
  @media (hover: hover) {
    .quiz :global(.quiz-option:not([disabled]):hover) { background: var(--bleu-clair); }
  }
  .quiz :global(.quiz-option:not([disabled]):active) { transform: translate(3px, 3px); box-shadow: none; }
  .quiz :global(.quiz-option[disabled]) { cursor: default; }
  .quiz :global(.quiz-option[disabled]:not(.juste):not(.faux)) { opacity: 0.45; box-shadow: none; }
  .quiz :global(.quiz-option.juste) { background: var(--pin-clair); }
  .quiz :global(.quiz-option.juste .quiz-lettre) { background: var(--pin-fort); color: #fff; }
  .quiz :global(.quiz-option.faux) { background: var(--rouge-clair); }
  .quiz :global(.quiz-option.faux .quiz-lettre) { background: var(--rouge-fort); color: #fff; }

  .quiz :global(.quiz-verdict) { border: 2px solid var(--contour); padding: 0.7rem 0.9rem; margin-bottom: 1rem; }
  .quiz :global(.quiz-verdict p) { margin: 0 0 0.4rem; }
  .quiz :global(.quiz-verdict p:last-child) { margin-bottom: 0; }
  .quiz :global(.quiz-verdict.juste) { background: var(--pin-clair); }
  .quiz :global(.quiz-verdict.faux) { background: var(--rouge-clair); }
  .quiz :global(.quiz-verdict-titre) { font-family: var(--police-pixel); font-size: 1.5rem; line-height: 1; }
  .quiz :global(.quiz-reprise) { font-family: var(--police-etiquette); font-size: 0.62rem; letter-spacing: 0.05em; text-transform: uppercase; }

  /* Écran final */
  .quiz :global(.quiz-fin) { text-align: center; padding: 0.1rem 0 0.1rem; }
  .quiz :global(.quiz-fin p:last-child) { margin-bottom: 0; }
  .quiz :global(.quiz-paysage) { margin: 0 0 0.9rem; border: 2px solid var(--contour); }
  .quiz :global(.quiz-fin-titre) { font-family: var(--police-pixel); font-size: 2.1rem; line-height: 1; margin: 0 0 0.35rem; }
  .quiz :global(.quiz-score) { font-family: var(--police-pixel); font-size: 1.5rem; color: var(--encre-douce); line-height: 1; margin: 0.4rem 0 0.7rem; }
  .quiz :global(.quiz-score strong) { font-weight: 400; font-size: 3.4rem; color: var(--encre); }
  .quiz :global(.quiz-cases) { height: 16px; margin: 0 0 1rem; }

  @media (prefers-reduced-motion: no-preference) {
    .quiz :global(.quiz-option) { animation: quiz-entree 240ms steps(3) backwards; animation-delay: calc(var(--i, 0) * 50ms); }
    .quiz :global(.quiz-option.juste .quiz-lettre) { animation: quiz-pop 300ms steps(3); }
    .quiz :global(.quiz-option.faux) { animation: quiz-secousse 300ms steps(4); }
    .quiz :global(.quiz-retour > *) { animation: quiz-entree 220ms steps(3) backwards; }
    .quiz :global(.quiz-retour > .bouton) { animation-delay: 80ms; }
    .quiz :global(.quiz-fin-titre) { animation: quiz-pop 400ms steps(4) 200ms backwards; }
    .quiz :global(.quiz-cases i.pleine) { animation: quiz-case 160ms steps(1) backwards; animation-delay: calc(var(--i) * 70ms); }
  }
  @keyframes quiz-entree { from { opacity: 0; transform: translateY(6px); } }
  @keyframes quiz-pop { 0% { transform: scale(1); } 45% { transform: scale(1.25); } 100% { transform: scale(1); } }
  @keyframes quiz-secousse { 20%, 60% { transform: translateX(-4px); } 40%, 80% { transform: translateX(4px); } }
  @keyframes quiz-case { from { background: var(--trait); } }
</style>
<script>
  import { monterQuiz } from '../scripts/quiz';
  import { enregistrerControle, lire, aRevoir } from '../scripts/progression';
  const monter = (el: HTMLElement) => {
    let qs: { id: string }[] = JSON.parse(el.dataset.questions!);
    if (el.dataset.revoir) {
      const ids = new Set(aRevoir(lire()));
      qs = qs.filter((q) => ids.has(q.id));
    }
    if (el.dataset.melanger) qs = qs.map((q) => [Math.random(), q] as const).sort((a, b) => a[0] - b[0]).map(([, q]) => q);
    const max = Number(el.dataset.max);
    if (max > 0) qs = qs.slice(0, max);
    if (!qs.length) return; // le contenu du slot (état vide) reste affiché
    monterQuiz(el, qs as never, {
      afficherSource: !!el.dataset.source,
      maitrise: !!el.dataset.maitrise,
      paysage: el.dataset.sceneFete,
      onTermine: (score, total) => {
        if (el.dataset.controle) enregistrerControle(el.dataset.controle, score, total);
        el.dispatchEvent(new CustomEvent('quiz-termine', { bubbles: true, detail: { score, total } }));
      },
      onFini: (score, total) => {
        el.dispatchEvent(new CustomEvent('quiz-fini', { bubbles: true, detail: { score, total } }));
      },
    });
  };
  document.querySelectorAll<HTMLElement>('.quiz[data-questions]').forEach((el) => {
    // « À revoir » dépend de l'état synchronisé : on attend la première synchro.
    if (el.dataset.revoir) document.addEventListener('progression', () => monter(el), { once: true });
    else monter(el);
  });
</script>
