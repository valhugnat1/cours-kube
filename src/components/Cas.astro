---
// Une carte de <Compare>. ton : "ok" (vert), "ko" (rouge) ou rien (neutre).
interface Props { titre: string; ton?: 'ok' | 'ko' }
const { titre, ton } = Astro.props;
---
<section class:list={['cas', 'px', ton]}><p class="cas-titre">{ton === 'ok' ? '✔ ' : ton === 'ko' ? '✘ ' : ''}{titre}</p><slot /></section>
<style>
  .cas { --coupe: 5px; --decale: 3px; padding: 0.65rem 0.7rem 0.1rem; font-size: 0.9rem; line-height: 1.45; min-width: 0; }
  .cas-titre { font-family: var(--police-pixel); font-size: 1.3rem; line-height: 1.05; margin: 0 0 0.4rem; }
  .cas.ok { --fond: var(--pin-clair); }
  .cas.ko { --fond: var(--rouge-clair); }
  .cas :global(ul) { padding-left: 1rem; margin-bottom: 0.6rem; }
  .cas :global(p) { margin-bottom: 0.6rem; }
</style>
